# انسخ هذا الملف الى .env (cp .env.example .env && chmod 600 .env). لا ترفع .env الى Git ولا تشاركه.
# ===== الأساسيات =====
TELEGRAM_BOT_TOKEN=
# ADMIN ids (ارقام حسابات الادمن، افصل بفاصلة). المصدر الوحيد لصلاحية ADMIN. المستخدمون العاديون (USER) يضيفهم الادمن من Admin Panel
AUTHORIZED_USER_IDS=
# ===== AI اختياري (بدونه يعمل البحث المحلي كاملاً) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_TIMEOUT_SEC=20
# ===== النسخ الاحتياطي (مطلوب للنسخ) =====
BACKUP_PASSPHRASE=
BACKUP_ALLOW_UNENCRYPTED=false
BACKUP_KEEP=7
AUTO_BACKUP_HOURS=0
# ===== الموارد =====
MAX_CPU_PERCENT=70
MAX_RAM_PERCENT=70
MIN_FREE_STORAGE_GB=5
MAX_STORAGE_USAGE_GB=35
BATCH_SIZE=500
CHUNK_SIZE=1048576
MAX_WORKERS=1
THROTTLE_DELAY_SEC=0
KEEP_AWAKE=false
# ===== الأرشيفات =====
MAX_ARCHIVE_FILES=200000
MAX_EXTRACT_RATIO=2000
MAX_EXTRACT_GB=0
MAX_ARCHIVE_DEPTH=3
BOMB_MIN_MB=256
KEEP_EXTRACTED=false
INTAKE_SETTLE_SEC=30
# ===== البحث والواجهة =====
SEARCH_TIMEOUT_SEC=30
RESULT_PAGE_SIZE=10
TELEGRAM_MESSAGE_LIMIT=4000
CALLBACK_TTL_MIN=1440
REPORT_RETENTION_DAYS=30
SEARCH_HISTORY_RETENTION_DAYS=30
AUTO_INDEX=true
AUTO_RESUME=true
JSON_MAX_OBJECT_MB=64
# ===== حدود Telegram (القيم من المعرفة العامة؛ لم يتحقق منها شبكياً) =====
TELEGRAM_DOWNLOAD_LIMIT_MB=20
TELEGRAM_UPLOAD_LIMIT_MB=50
TELEGRAM_POLL_TIMEOUT=30
# ===== السجلات =====
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# ===== اختياري =====
PDF_FONT_PATH=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TELEGRAM_API_BASE=https://api.telegram.org
AI_CACHE_SIZE=128
# ===== Entity Resolution (تُضبط ايضاً من Admin Panel) =====
# الاعدادات التالية تُخزَّن في القاعدة (settings) وتُعدَّل من Admin Panel > Entity Resolution:
#   er_auto (مطابقة تلقائية بعد كل فهرسة) و er_auto_export (ارسال Unified Excel للادمن بعد المطابقة)
FORCE_SUB_CACHE_SEC=60
